{
  "id": "smalltalk",
  "title": "Small talk & connection",
  "tier": 2,
  "grammar": {
    "title": "menin nta? — where are you from?",
    "body": "A little warmth goes a long way in Morocco. **menin nta?** ('where are you from?', to a man; **menin nti?** to a woman) opens the door. Answer with **ana men ___** (I'm from ___). Complimenting the country — **lmaghrib zwin!** — and thanking hospitality land especially well."
  },
  "canDo": [
    "Introduce yourself and ask where someone's from",
    "Say it's your first time and that you love Morocco",
    "Thank someone for their hospitality"
  ],
  "items": [
    { "target": "smiti", "roman": "smiti", "arabic": "سميتي", "english": "my name is…", "role": "produce" },
    { "target": "ash smitek?", "roman": "ash smitek", "arabic": "أش سميتك", "english": "what's your name?", "role": "produce" },
    { "target": "mtsharfin", "roman": "mtsharfin", "arabic": "متشرفين", "english": "nice to meet you", "role": "produce" },
    { "target": "menin nta?", "roman": "menin nta", "arabic": "منين نتا", "english": "where are you from?", "role": "produce", "note": "To a woman: menin nti?" },
    { "target": "ana men amirika", "roman": "ana men amirika", "arabic": "أنا من أمريكا", "english": "I'm from America", "role": "produce", "note": "Swap in your country." },
    { "target": "ana siya7", "roman": "ana siya7", "arabic": "أنا سياح", "english": "I'm a tourist", "role": "produce" },
    { "target": "awwel merra f lmaghrib", "roman": "awwel merra f lmaghrib", "arabic": "أول مرة فالمغرب", "english": "my first time in Morocco", "role": "produce" },
    { "target": "lmaghrib zwin", "roman": "lmaghrib zwin", "arabic": "المغرب زوين", "english": "Morocco is beautiful", "role": "produce", "note": "Flattery that's also true — it lands well." },
    { "target": "3jbatni", "roman": "3jbatni", "arabic": "عجباتني", "english": "I like it", "role": "produce" },
    { "target": "shukran 3la d-diyafa", "roman": "shukran 3la d-diyafa", "arabic": "شكرا على الضيافة", "english": "thank you for the hospitality", "role": "produce", "note": "Moroccans are famously hospitable — this is deeply appreciated." },
    { "target": "bslama, thlla f rasek", "roman": "bslama thlla f rasek", "arabic": "بسلامة، تهلا فراسك", "english": "bye, take care of yourself", "role": "produce", "note": "A warm goodbye." },
    { "target": "mrhba", "roman": "mrhba", "arabic": "مرحبا", "english": "welcome / you're welcome", "role": "recognize", "note": "You'll hear it constantly — as 'welcome!' and as 'no problem'." },
    { "target": "bslmtek", "roman": "bslmtek", "arabic": "بسلامتك", "english": "you're welcome / at your service", "role": "recognize" }
  ]
